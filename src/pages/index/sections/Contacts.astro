---
const contactMethods = [
  {
    label: "Phone",
    value: "09933272908",
    href: "tel:09933272908",
  },
  {
    label: "Instagram",
    value: "@jive.miguel",
    href: "https://instagram.com",
  },

  {
    label: "Location",
    value: "Victorias City",
    href: "https://maps.google.com/?q=Victorias+City",
  },
  {
    label: "Name",
    value: "Jive Miguel Valencia Dequito",
    href: "https://www.linkedin.com/in/jive-miguel-valencia-dequito-7a0b4b1b3/",
  },
  {
    label: "Email",
    value: "c20245392.dequito@csav.edu.ph",
    href: "mailto:c20245392.dequito@csav.edu.ph",
  },
];

const quickLinks = [
  "Brand Strategy",
  "Web Design",
  "Creative Direction",
  "Product Storytelling",
];
---

<section
  id="contact"
  class="bg-white py-20 text-black dark:bg-black dark:text-white"
>
  <div class="mx-auto max-w-6xl px-6 lg:px-10">
    <div class="silver-accent-border rounded-2xl border bg-white p-8 dark:bg-black sm:p-10">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl" data-reveal>
          <p class="silver-chip mb-3 inline-flex rounded-sm px-2 py-1 text-xs font-semibold uppercase tracking-[0.2em]">
            Let’s connect
          </p>
          <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
            Bring your next idea into motion.
          </h2>
        </div>

        <a
          href="mailto:c20245392.dequito@csav.edu.ph"
          data-reveal
          class="silver-button inline-flex items-center justify-center rounded-md px-6 py-3 text-sm font-medium"
        >
          Start a project
        </a>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {contactMethods.map((item) => (
          <a
            href={item.href}
            data-reveal="card"
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noreferrer" : undefined}
            class:list={[
              "silver-accent-border group rounded-xl border bg-white p-5 dark:bg-black",
              item.label === "Email" && "md:col-span-2 lg:col-span-2",
            ]}
          >
            <span class="mb-3 block text-xs font-semibold uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400">
              {item.label}
            </span>
            <strong
              class:list={[
                "block text-base font-medium text-black dark:text-white",
                item.label === "Email" && "break-all",
              ]}
            >
              {item.value}
            </strong>
          </a>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        {quickLinks.map((tag) => (
          <span class="silver-chip rounded-sm px-3 py-2 text-xs font-medium uppercase tracking-[0.1em]">
            {tag}
          </span>
        ))}
      </div>

      <form id="contact-message-form" class="mt-10 grid gap-5" data-reveal>
        <h3 class="text-2xl font-bold">Message</h3>
        <label class="grid gap-2 text-sm font-medium">
          Your email
          <input
            type="email"
            name="email"
            autocomplete="email"
            required
            class="silver-field rounded-md border bg-white px-4 py-3 text-black dark:bg-black dark:text-white"
          />
        </label>
        <label class="grid gap-2 text-sm font-medium">
          Your message
          <textarea
            name="message"
            rows="5"
            required
            class="silver-field resize-y rounded-md border bg-white px-4 py-3 text-black dark:bg-black dark:text-white"
          ></textarea>
        </label>
        <div>
          <button
            type="submit"
            class="silver-button inline-flex items-center justify-center rounded-md px-6 py-3 text-sm font-medium"
          >
            Send message
          </button>
          <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">
            This will open your email app with your message ready to send.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const messageForm = document.querySelector<HTMLFormElement>(
    "#contact-message-form",
  );

  messageForm?.addEventListener("submit", (event) => {
    event.preventDefault();

    const formData = new FormData(messageForm);
    const email = String(formData.get("email") ?? "");
    const message = String(formData.get("message") ?? "");
    const subject = encodeURIComponent("Message from portfolio website");
    const body = encodeURIComponent(`From: ${email}\n\n${message}`);

    window.location.href = `mailto:c20245392.dequito@csav.edu.ph?subject=${subject}&body=${body}`;
  });
</script>
