---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
const name = "Jive Miguel Dequito";
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{name}</title>
</head>

<body class="portfolio-reveal min-h-screen bg-white text-black dark:bg-black dark:text-white">

    <!-- HEADER -->
    <header class="silver-accent-border flex flex-wrap items-center justify-between gap-4 border-b bg-white px-6 py-4 dark:bg-black">

        <h2 class="text-sm font-semibold tracking-tight sm:text-base">
            {name}
        </h2>

        <!-- NAVIGATION -->
        <nav class="order-3 flex w-full gap-2 text-sm text-black dark:text-white sm:order-none sm:w-auto">
            <a class="silver-nav-link rounded-sm px-2 py-1" href="#about">About</a>
            <a class="silver-nav-link rounded-sm px-2 py-1" href="#contact">Contact</a>
        </nav>

        <div class="flex items-center gap-2">
            <button
                id="replayAnimation"
                type="button"
                aria-label="Replay portfolio animations"
                class="silver-button rounded-md px-3 py-2 text-xs font-medium"
            >
                Replay animation
            </button>
            <button
                id="darkModeToggle"
                type="button"
                aria-pressed="false"
                class="theme-toggle silver-button rounded-md px-3 py-2 text-xs font-medium"
            >
                <span id="themeLabel">Dark Mode</span>
            </button>
        </div>

    </header>

    <!-- CONTENT -->
    <main>
        <slot />
    </main>

   

    <Footer />

    <script>
        import "../scripts/animation.js";
    </script>
</body>

</html>